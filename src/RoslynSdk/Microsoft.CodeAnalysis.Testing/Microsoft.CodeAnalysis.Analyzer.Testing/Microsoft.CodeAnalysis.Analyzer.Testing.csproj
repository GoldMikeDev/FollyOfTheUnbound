<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TestingLibraryTargetFrameworks)</TargetFrameworks>
    <AssemblyName>Microsoft.CodeAnalysis.Analyzer.Testing</AssemblyName>
    <RootNamespace>Microsoft.CodeAnalysis.Testing</RootNamespace>
    <DefineConstants>$(DefineConstants);NUGET_SIGNING</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Roslyn Analyzer Test Framework Common Types.</Description>
    <PackageReleaseNotes>Roslyn Analyzer Test Framework Common Types</PackageReleaseNotes>
    <PackageTags>Roslyn Analyzer Test Framework Common</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.CodeFix.Testing" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.CodeRefactoring.Testing" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.SourceGenerators.Testing" />

    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.Analyzer.Testing.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- When built as part of this fork's own solution (FollyOfTheUnbound.slnx), reference our renamed
         Microsoft.CodeAnalysis.Workspaces.csproj directly instead of the real, un-renamed
         Microsoft.CodeAnalysis.Workspaces.Common package below: its PackageId still matches that real
         package, so NuGet's project-substitution mechanism picks this up automatically, making this
         library's own compiled types (e.g. via Microsoft.CodeAnalysis.CodeFix.Testing's CodeFixTest<T>)
         resolve against our renamed assembly rather than the real one, see
         Microsoft.CodeAnalysis.Workspaces.UnitTests.csproj's exclusion comment in FollyOfTheUnbound.slnx
         for the identity-collision this fixes. $(SolutionName) is only set when actually building via a
         .sln/.slnx, and only equals "FollyOfTheUnbound" for this fork's own solution, so a standalone
         build of this project (e.g. via Roslyn.slnx, which is what actually publishes the real,
         externally-consumed Microsoft.CodeAnalysis.Analyzer.Testing NuGet package) is entirely
         unaffected: it keeps using the real package below, unchanged. -->
    <ProjectReference Include="..\..\..\Workspaces\Core\Portable\Microsoft.CodeAnalysis.Workspaces.csproj"
                       Condition="'$(SolutionName)' == 'FollyOfTheUnbound'" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
    <PackageReference Include="Microsoft.VisualBasic" Condition="'$(TargetFrameworkIdentifier)' == '.NETStandard'" />
    <PackageReference Include="Microsoft.VisualStudio.Composition" VersionOverride="16.1.8" />
    <PackageReference Include="Nullable" PrivateAssets="all" />
    <PackageReference Include="System.Formats.Asn1" />
    <!-- Use PrivateAssets=compile to avoid exposing our NuGet dependencies downstream as public API. -->
    <PackageReference Include="NuGet.Common" PrivateAssets="compile" />
    <PackageReference Include="NuGet.Protocol" PrivateAssets="compile" />
    <PackageReference Include="NuGet.Resolver" PrivateAssets="compile" />
    <PackageReference Include="NuGet.Packaging" PrivateAssets="compile" />

    <!-- Use PrivateAssets=compile to avoid exposing our DiffPlex dependency downstream as public API. -->
    <PackageReference Include="DiffPlex" PrivateAssets="compile" />
  </ItemGroup>
</Project>
