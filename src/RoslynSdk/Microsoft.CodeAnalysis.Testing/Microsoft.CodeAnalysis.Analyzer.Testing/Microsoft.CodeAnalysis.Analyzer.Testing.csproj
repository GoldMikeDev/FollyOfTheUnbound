<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TestingLibraryTargetFrameworks)</TargetFrameworks>
    <AssemblyName>Microsoft.CodeAnalysis.Analyzer.Testing</AssemblyName>
    <RootNamespace>Microsoft.CodeAnalysis.Testing</RootNamespace>
    <DefineConstants>$(DefineConstants);NUGET_SIGNING</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Roslyn Analyzer Test Framework Common Types.</Description>
    <PackageReleaseNotes>Roslyn Analyzer Test Framework Common Types</PackageReleaseNotes>
    <PackageTags>Roslyn Analyzer Test Framework Common</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.CodeFix.Testing" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.CodeRefactoring.Testing" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.SourceGenerators.Testing" />

    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.Analyzer.Testing.UnitTests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- True when building as part of this fork, under either of the two ways that happens:
         folly.ps1/folly.sh always pass /p:FollyOfTheUnboundBuild=true directly (see BuildSolution's
         own MSBuild invocation in eng/build.ps1/eng/build.sh: it invokes MSBuild on Arcade's toolset
         Build.proj, passing the .slnx path only via /p:Projects=..., so MSBuild's own $(SolutionName)
         is never auto-derived there and stays Microsoft.Common.CurrentVersion.targets' "*Undefined*"
         default; confirmed via `dotnet nuget why`, which showed the real package still resolving
         directly despite a Condition keyed on $(SolutionName) alone). CI's codeql.yml instead runs
         `dotnet build FollyOfTheUnbound.slnx` directly, which DOES auto-derive $(SolutionName) to
         "FollyOfTheUnbound" (the entry file genuinely is the .slnx there), but never sets
         FollyOfTheUnboundBuild. Checking both covers each path; a standalone build of this project
         (e.g. via Roslyn.slnx, which is what actually publishes the real, externally-consumed
         Microsoft.CodeAnalysis.Analyzer.Testing NuGet package) sets neither and is unaffected. -->
    <IsFollyOfTheUnboundBuild Condition="'$(FollyOfTheUnboundBuild)' == 'true' OR '$(SolutionName)' == 'FollyOfTheUnbound'">true</IsFollyOfTheUnboundBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference our renamed Microsoft.CodeAnalysis.Workspaces.csproj directly instead of the real,
         un-renamed Microsoft.CodeAnalysis.Workspaces.Common package below, see
         Microsoft.CodeAnalysis.Workspaces.UnitTests.csproj's exclusion comment in
         FollyOfTheUnbound.slnx for the identity-collision this fixes. -->
    <ProjectReference Include="..\..\..\Workspaces\Core\Portable\Microsoft.CodeAnalysis.Workspaces.csproj"
                       Condition="'$(IsFollyOfTheUnboundBuild)' == 'true'" />
    <!-- Excluded (not just left to NuGet's automatic project/package substitution) when building this
         fork: substitution is keyed off matching PackageIds within the SAME restore's TargetFramework
         node, but Microsoft.CodeAnalysis.Workspaces.csproj above doesn't target net472 (only
         $(NetRoslynSourceBuild);netstandard2.0), so for this project's net472 TFM the ProjectReference
         only resolves via the netstandard2.0 asset (which net472 can consume, but not as a substitute),
         so the real package still gets pulled in alongside it, causing CS0433 (Project/Solution/etc.
         defined in both assemblies). Excluding the PackageReference outright avoids depending on that
         TFM-matching behavior instead of trying to satisfy it. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Condition="'$(IsFollyOfTheUnboundBuild)' != 'true'" />
    <PackageReference Include="Microsoft.VisualBasic" Condition="'$(TargetFrameworkIdentifier)' == '.NETStandard'" />
    <PackageReference Include="Microsoft.VisualStudio.Composition" VersionOverride="16.1.8" />
    <PackageReference Include="Nullable" PrivateAssets="all" />
    <PackageReference Include="System.Formats.Asn1" />
    <!-- Use PrivateAssets=compile to avoid exposing our NuGet dependencies downstream as public API. -->
    <PackageReference Include="NuGet.Common" PrivateAssets="compile" />
    <PackageReference Include="NuGet.Protocol" PrivateAssets="compile" />
    <PackageReference Include="NuGet.Resolver" PrivateAssets="compile" />
    <PackageReference Include="NuGet.Packaging" PrivateAssets="compile" />

    <!-- Use PrivateAssets=compile to avoid exposing our DiffPlex dependency downstream as public API. -->
    <PackageReference Include="DiffPlex" PrivateAssets="compile" />
  </ItemGroup>
</Project>
