<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TestingLibraryTargetFrameworks)</TargetFrameworks>
    <AssemblyName>Microsoft.CodeAnalysis.CodeFix.Testing</AssemblyName>
    <RootNamespace>Microsoft.CodeAnalysis.Testing</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Roslyn Code Fix Test Framework Common Types.</Description>
    <PackageReleaseNotes>Roslyn Code Fix Test Framework Common Types</PackageReleaseNotes>
    <PackageTags>Roslyn Code Fix Test Framework Common</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- See the matching comment (including why the PackageReference below is excluded, not left to
         automatic substitution, and why this checks $(FollyOfTheUnboundBuild) rather than
         $(SolutionName)) in Microsoft.CodeAnalysis.Analyzer.Testing.csproj. Only active when built via
         folly.ps1/folly.sh, no effect on the real, externally-published package. -->
    <ProjectReference Include="..\..\..\Workspaces\Core\Portable\Microsoft.CodeAnalysis.Workspaces.csproj"
                       Condition="'$(FollyOfTheUnboundBuild)' == 'true'" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Condition="'$(FollyOfTheUnboundBuild)' != 'true'" />
    <PackageReference Include="System.Formats.Asn1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.CodeAnalysis.Analyzer.Testing\Microsoft.CodeAnalysis.Analyzer.Testing.csproj" />
  </ItemGroup>
</Project>
