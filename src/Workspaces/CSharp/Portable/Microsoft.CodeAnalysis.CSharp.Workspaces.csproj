<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Microsoft.CodeAnalysis.CSharp</RootNamespace>
    <!-- Renamed so this assembly's identity doesn't collide with VS's in-box Roslyn (devenv.exe.config
         binding-redirects any Microsoft.CodeAnalysis.* reference onto VS's own copy). -->
    <AssemblyName>FollyOfTheUnbound.CodeAnalysis.CSharpUnbound.Workspaces</AssemblyName>
    <StrongNameKeyId>FollyOfTheUnbound</StrongNameKeyId>
    <AssemblyOriginatorKeyFile>$(FollyOfTheUnboundKeyFile)</AssemblyOriginatorKeyFile>
    <PublicKey>$(FollyOfTheUnboundPublicKey)</PublicKey>
    <PublicKeyToken>$(FollyOfTheUnboundPublicKeyToken)</PublicKeyToken>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFrameworks>$(NetRoslynSourceBuild);netstandard2.0</TargetFrameworks>
    <DefineConstants>$(DefineConstants);CSHARP_WORKSPACE</DefineConstants>
    <ApplyNgenOptimization Condition="'$(TargetFramework)' == 'netstandard2.0'">full</ApplyNgenOptimization>

    <!-- NuGet -->
    <IsPackable>true</IsPackable>
    <!-- Keep the real upstream PackageId even though AssemblyName above is renamed: PackageId only
         affects NuGet's dependency graph, not the CLR/VS-visible assembly identity, and matching it
         lets NuGet auto-substitute this project for the real Microsoft.CodeAnalysis.CSharp.Workspaces
         package everywhere in the graph, avoiding the CS0433 identity collision that otherwise
         requires excluding the real package's compile assets project-by-project (see
         Microsoft.CodeAnalysis.Workspaces.Test.Utilities.csproj's now-removed workaround). Mirrors the
         same pattern already used by the base Microsoft.CodeAnalysis.Workspaces.csproj. -->
    <PackageId>Microsoft.CodeAnalysis.CSharp.Workspaces</PackageId>
    <PackageDescription>
      .NET Compiler Platform ("Roslyn") support for analyzing C# projects and solutions.
    </PackageDescription>
  </PropertyGroup>
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\..\..\Compilers\Core\Portable\Microsoft.CodeAnalysis.csproj" />
    <ProjectReference Include="..\..\..\Compilers\CSharp\Portable\Microsoft.CodeAnalysis.CSharp.csproj" />
    <ProjectReference Include="..\..\Core\Portable\Microsoft.CodeAnalysis.Workspaces.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Humanizer.Core" PrivateAssets="compile" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FollyOfTheUnbound.CodeAnalysis.CSharpUnbound.EditorFeatures" />
    <InternalsVisibleTo Include="FollyOfTheUnbound.CodeAnalysis.CSharpUnbound.Features" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.CSharp.LanguageServer.Protocol" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="FollyOfTheUnbound.LanguageServices.CSharpUnbound" />
    <InternalsVisibleTo Include="Roslyn.Hosting.Diagnostics" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.CSharp.Features.UnitTests" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.CSharp.EditorFeatures.UnitTests" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.CSharp.EditorFeatures2.UnitTests" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.Features.UnitTests" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.EditorFeatures.UnitTests" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.EditorFeatures2.UnitTests" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.Workspaces.UnitTests" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.CSharp.Workspaces.UnitTests" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.VisualStudio.LanguageServices.CSharp.UnitTests" Key="$(MicrosoftSharedPublicKey)" />
