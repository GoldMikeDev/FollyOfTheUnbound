    <RootNamespace>Microsoft.CodeAnalysis</RootNamespace>
    <!-- Renamed so this assembly's identity doesn't collide with VS's in-box Roslyn (devenv.exe.config
         binding-redirects any Microsoft.CodeAnalysis.* reference onto VS's own copy). -->
    <AssemblyName>FollyOfTheUnbound.CodeAnalysis.Features</AssemblyName>
    <StrongNameKeyId>FollyOfTheUnbound</StrongNameKeyId>
    <AssemblyOriginatorKeyFile>$(FollyOfTheUnboundKeyFile)</AssemblyOriginatorKeyFile>
