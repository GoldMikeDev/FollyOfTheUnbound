<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWpf>true</UseWpf>
    <RootNamespace>Microsoft.VisualStudio.LanguageServices.Implementation</RootNamespace>
    <!-- Renamed so this assembly's identity doesn't collide with VS's in-box Roslyn (devenv.exe.config
         binding-redirects any Microsoft.CodeAnalysis.*/Microsoft.VisualStudio.LanguageServices.* reference
         onto VS's own copy). -->
    <AssemblyName>FollyOfTheUnbound.LanguageServices.Implementation</AssemblyName>
    <StrongNameKeyId>FollyOfTheUnbound</StrongNameKeyId>
    <AssemblyOriginatorKeyFile>$(FollyOfTheUnboundKeyFile)</AssemblyOriginatorKeyFile>
    <PublicKey>$(FollyOfTheUnboundPublicKey)</PublicKey>
    <PublicKeyToken>$(FollyOfTheUnboundPublicKeyToken)</PublicKeyToken>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplyNgenOptimization>full</ApplyNgenOptimization>
    <IsSymbolPublishingPackage>true</IsSymbolPublishingPackage>
  </PropertyGroup>
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\..\..\Compilers\Core\Portable\Microsoft.CodeAnalysis.csproj" />
    <ProjectReference Include="..\..\..\EditorFeatures\Core\Microsoft.CodeAnalysis.EditorFeatures.csproj" />
    <ProjectReference Include="..\..\..\Workspaces\Core\Portable\Microsoft.CodeAnalysis.Workspaces.csproj" />
    <ProjectReference Include="..\..\..\Features\Core\Portable\Microsoft.CodeAnalysis.Features.csproj" />
    <ProjectReference Include="..\..\..\EditorFeatures\Text\Microsoft.CodeAnalysis.EditorFeatures.Text.csproj" />
    <ProjectReference Include="..\Def\Microsoft.VisualStudio.LanguageServices.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FollyOfTheUnbound.LanguageServices.CSharpUnbound" />
    <InternalsVisibleTo Include="Microsoft.VisualStudio.LanguageServices.VisualBasic" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.VisualStudio.LanguageServices.Xaml" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Roslyn.VisualStudio.DiagnosticsWindow" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.VisualStudio.LanguageServices.CSharp.UnitTests" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.VisualStudio.LanguageServices.UnitTests" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.VisualStudio.LanguageServices.Test.Utilities2" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.ExternalAccess.FSharp" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.VisualStudio.LanguageServices.ExternalAccess.UnitTests" Key="$(MicrosoftSharedPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.VisualStudio.LanguageServices.TypeScript" Key="$(TypeScriptKey)" WorkItem="https://github.com/dotnet/roslyn/issues/35077" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.TypeScript.EditorFeatures" Key="$(TypeScriptKey)" WorkItem="https://github.com/dotnet/roslyn/issues/35077" />
    <InternalsVisibleTo Include="FSharp.Editor" Key="$(FSharpKey)" WorkItem="https://github.com/dotnet/roslyn/issues/35076" />
    <InternalsVisibleTo Include="FSharp.LanguageService" Key="$(FSharpKey)" WorkItem="https://github.com/dotnet/roslyn/issues/35076" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsFormsIntegration" />
    <EmbeddedResource Update="SolutionExplorerShim.resx" GenerateSource="true" />
    <PackageReference Include="Microsoft.CSharp" />
    <PackageReference Include="Microsoft.VisualStudio.ProjectSystem" />
    <PackageReference Include="Microsoft.VisualStudio.Sdk" />
    <PackageReference Include="Microsoft.VisualStudio.CodeAnalysis.Sdk.UI" />
  </ItemGroup>
</Project>
